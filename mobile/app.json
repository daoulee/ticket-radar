{
  "expo": {
    "name": "티켓레이더",
    "slug": "ticket-radar-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.aid.ticketradar"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.aid.ticketradar"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/splash-blank.png",
          "imageWidth": 8
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "판매글 캡처 이미지를 골라 기기 안에서 글자를 읽기 위해 사진에 접근합니다. 이미지는 서버로 보내거나 저장하지 않습니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ],
    "scheme": "ticketradar"
  }
}
