# No model is called with this default. Never commit a populated .env.
# KOPIS 공연 목록 검색 키는 서버 환경에서만 설정한다.
# KOPIS_API_KEY=<set-in-server-environment-only>
EXTRACTION_PROVIDER=none
# Optional local provider; choose model explicitly after checking availability.
# EXTRACTION_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# AI_MODEL=<local-model-name>
# Cloud provider (Gemini, current choice 2026-11-03). Key only in server/.env.
# EXTRACTION_PROVIDER=gemini
# GEMINI_API_KEY=<set-in-local-.env-only>
# AI_MODEL=gemini-3.1-flash-lite
# Cloud provider (Claude, ready when an Anthropic key exists). Put the real key only in server/.env on the server machine.
# EXTRACTION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=<set-in-local-.env-only>
# AI_MODEL=claude-opus-5-5
# Cloud calls need more time than the local default; 30000 is recommended with anthropic.
AI_TIMEOUT_MS=10000
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Resend 키와 발신 주소는 서버 환경에만 설정한다. 미설정 시 인증 메일 발송은 실패한다.
# RESEND_API_KEY=<set-in-server-environment-only>
# RESEND_FROM=onboarding@resend.dev
# EMAIL_PROVIDER=gmail
# GMAIL_USER=<gmail-address>
# GMAIL_APP_PASSWORD=<google-app-password>
# Only behind a trusted reverse proxy/tunnel: use the first X-Forwarded-For address for rate limits.
# TRUST_PROXY=1
# Local testing only: allow /auth/signup without email verification. Never set this on a shared/public server.
# ALLOW_SIGNUP_WITHOUT_EMAIL=1
# 인증 메일 서버 전체 하루 발송 상한(기본 300, 주소당은 하루 5통 고정). Gmail 무료 계정 한도(약 500/일)보다 낮게 둔다.
# EMAIL_DAILY_LIMIT=300

# Gmail API OAuth 방식 (선택): 발송 전용 OAuth 권한과 서버 비밀 설정 필요
# EMAIL_PROVIDER=gmail-api
# GMAIL_USER=<gmail-address>
# GMAIL_OAUTH_CLIENT_ID=<oauth-client-id>
# GMAIL_OAUTH_CLIENT_SECRET=<oauth-client-secret>
# GMAIL_OAUTH_REFRESH_TOKEN=<oauth-refresh-token>
